{
  "info": {
    "name": "3657 Castillo Oviedo PA4 API MVC",
    "description": "Seis módulos CRUD. Ejecutar la colección completa y en orden sobre una base de pruebas. Datos ficticios. DELETE conserva el historial. Arquitectura adaptada de leyngab-isil/3657_PAGINA_WEB.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8084"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === \"Crear paciente\") {",
          "  pm.collectionVariables.set(\"run_id\", Date.now().toString(36) + Math.random().toString(36).slice(2,6));",
          "  const start = new Date(); start.setUTCDate(start.getUTCDate() + 16000 + Math.floor(Math.random() * 3000));",
          "  for (let i=1; i<=3; i++) { const d=new Date(start); d.setUTCDate(d.getUTCDate()+i); pm.collectionVariables.set(\"fecha\"+i, d.toISOString().slice(0,10)+\"T09:00:00\"); }",
          "}"
        ]
      }
    }
  ],
  "item": [
